# Server
PORT=3001
NODE_ENV=development

# Firebase (Spark Plan - No billing required)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=your-bot-token-from-botfather
TELEGRAM_WEBHOOK_URL=https://your-railway-app.up.railway.app/api/webhooks/telegram
# Optional: Cloudflare Worker proxy for Telegram API (bypasses Railway IP blocks)
TELEGRAM_API_URL=https://your-telegram-proxy.your-account.workers.dev

# Google Gemini API (via Google AI Studio - Free)
GEMINI_API_KEY=your-gemini-api-key

# Groq (for Whisper voice transcription - Free)
GROQ_API_KEY=your-groq-api-key

# SendGrid (Free tier - 100 emails/day)
SENDGRID_API_KEY=your-sendgrid-api-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com

# Cron Job Secret (for cron-job.org webhook authentication)
CRON_SECRET=your-random-secret-string

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173
