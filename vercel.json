{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd packages/shared && npm run build && cd ../../apps/web && npm run build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
